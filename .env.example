# Pipkin, the parcel-carrying code otter.
# Copy to ~/.config/pipkin/.env (recommended), or your project's .env.
# Never commit real keys. Existing exported environment variables take priority.
# OpenAI hosted profile. Uncomment these lines to select it.
# PIPKIN_PROVIDER=openai
# PIPKIN_BASE_URL=https://api.openai.com/v1
# PIPKIN_MODEL=gpt-5.1
# PIPKIN_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=your-real-key
#
# Local vLLM profile. Uncomment this block instead. Use the model ID served
# by your instance (see curl http://127.0.0.1:9999/v1/models).
# PIPKIN_PROVIDER=vllm
# PIPKIN_BASE_URL=http://127.0.0.1:9999/v1
# PIPKIN_MODEL=Qwen/Qwen3-4B-AWQ
# If your vLLM server requires a key, uncomment the next two lines.
# PIPKIN_API_KEY_ENV=VLLM_API_KEY
# VLLM_API_KEY=your-local-key
#
# PIPKIN_MODEL takes precedence over OPENAI_MODEL and config.json's model.
# Optional Langfuse observability. Set your instance URL and uncomment all three.
# LANGFUSE_BASE_URL=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Opt in to sending LLM input/output text to your Langfuse instance.
# Text-mode input may contain selected source code/PII/system prompts and will export it to your langfuse server.
# PIPKIN_LANGFUSE_CAPTURE_IO=1
# Optional local-only web review interface; omit or leave blank to disable.
# LISTEN_URL=http://127.0.0.1:8787
# Optional: defaults to ~/pipkin/outputs
# PIPKIN_OUTPUT_DIR=/home/jake/pipkin/outputs

# Optional agent profile defined in config.json. Omit for the built-in runner.
# PIPKIN_AGENT_PROFILE=thorough